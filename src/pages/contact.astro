---
import Layout from "../layouts/Layout.astro";
import GithubIcon from "../icons/github.astro";
import LinkedinIcon from "../icons/linkedin.astro";
import MailIcon from "../icons/mail.astro";
import FileTextIcon from "../icons/file-text.astro";

const links = [
  {
    label: "Email",
    value: "amnarafi43@gmail.com",
    href: "mailto:amnarafi43@gmail.com",
    icon: MailIcon,
  },
  {
    label: "LinkedIn",
    value: "amna-rafi-93966a270",
    href: "https://www.linkedin.com/in/amna-rafi-93966a270/",
    icon: LinkedinIcon,
  },
  {
    label: "GitHub",
    value: "girlmeetsfast",
    href: "https://github.com/girlmeetsfast",
    icon: GithubIcon,
  },
];
---

<Layout title="Contact - Amna Rafi">
  <main>
    <div class="page-hero scroll-reveal">
      <h1 class="page-title">Get In Touch</h1>
      <p class="page-subtitle">
        I'm always open to discussing new opportunities, collaborations, or just
        talking product and design. Reach out through any of the channels below.
      </p>
    </div>

    <div class="contact-grid">
      {
        links.map((link, i) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`contact-card scroll-reveal delay-${i + 1}`}
          >
            <span class="contact-icon">
              <link.icon />
            </span>
            <span class="contact-text">
              <span class="contact-label">{link.label}</span>
              <span class="contact-value">{link.value}</span>
            </span>
          </a>
        ))
      }
    </div>

    <section class="resume-cta scroll-reveal delay-4">
      <div class="cta-inner">
        <div class="cta-orb"></div>
        <span class="resume-icon">
          <FileTextIcon />
        </span>
        <h2 class="cta-heading">Want the full story?</h2>
        <p class="cta-body">
          Download my resume for a complete look at my experience, skills, and
          projects.
        </p>
        <a href="/Amna-Rafi-Resume.pdf" target="_blank" rel="noopener noreferrer" class="cta-button primary">
          View / Download Resume
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .page-hero {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    margin: 0 0 1rem 0;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-subtitle {
    max-width: 70ch;
    color: var(--text-light);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    color: var(--text);
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }

  .contact-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
    background: var(--light-bg);
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 0.75rem;
    background: var(--light-bg);
    color: var(--primary-light);
  }

  .contact-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .contact-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-light);
  }

  .contact-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .resume-cta {
    margin-top: 4rem;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }

  .cta-inner {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 1.5rem;
    padding: 3rem 2.5rem;
    text-align: center;
    position: relative;
    backdrop-filter: blur(10px);
    overflow: hidden;
  }

  .cta-orb {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.2) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .resume-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 1rem;
    background: var(--light-bg);
    color: var(--primary-light);
    margin-bottom: 1.25rem;
  }

  .cta-heading {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--color);
    margin: 0 0 1rem 0;
    line-height: 1.3;
  }

  .cta-body {
    max-width: 55ch;
    margin: 0 auto 2rem auto;
    color: var(--text-light);
    font-size: 1rem;
    line-height: 1.7;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.8rem;
    border-radius: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease, opacity 0.3s ease;
  }

  .cta-button.primary {
    background: var(--accent-gradient);
    color: white;
  }

  .cta-button.primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 24px rgba(139, 92, 246, 0.4);
  }

  @media (max-width: 450px) {
    .page-hero {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
    }

    .cta-inner {
      padding: 2rem 1.5rem;
    }

    .cta-button {
      font-size: 0.85rem;
      padding: 0.6rem 1.4rem;
    }
  }
</style>
